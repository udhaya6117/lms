PORT=5000
NODE_ENV=development
# Local MongoDB or MongoDB Atlas.
# Atlas example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/lms?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/lms
# Set false to disable the in-memory fallback and require a real MongoDB connection.
USE_MEMORY_DB=false
# Production requires unique secrets of at least 32 characters. Never commit real values.
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
CLIENT_ORIGIN=http://localhost:3000
# lax | strict | none  (none is the production default when frontend and API are on different sites)
COOKIE_SAMESITE=lax
# Demo / first-run seed only. Change these before any real deployment.
SEED_ADMIN_EMAIL=admin@lms.com
SEED_ADMIN_PASSWORD=Admin@123
SEED_TRAINER_PASSWORD=Trainer@123
SEED_STUDENT_PASSWORD=Student@123
# Production never auto-seeds unless this is true AND the SEED_* passwords are not the demo defaults.
SEED_ON_EMPTY=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
